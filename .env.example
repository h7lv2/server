# --- Domains & Email ---
PRIMARY_DOMAIN=yourdomain.com

# --- Service Primary Domains ---
# These are the main domains for each service
VAULT_SUBDOMAIN=vault
PDS_SUBDOMAIN=pds
PDS_HOSTNAME=pds.yourdomain.com

# --- S-UI Domain ---
SUI_DOMAIN=your-other-domain.com
SUI_SUBDOMAIN=proxy

EMAIL=your@email.com

# --- Traefik / Cloudflare ---
# Cloudflare DNS API token with Zone:Read and DNS:Edit on the zone
CF_DNS_API_TOKEN=your_cloudflare_dns_api_token

# --- Shared Postgres Settings ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=veryverystrongpassword
# Comma-separated list of DBs to create automatically
POSTGRES_MULTIPLE_DATABASES=vaultwarden,pds,another_app

# --- Tranquil PDS secrets ---
# Generate strong random values for these
JWT_SECRET=replace_me_with_a_long_random_secret
DPOP_SECRET=replace_me_with_a_long_random_secret
MASTER_KEY=replace_me_with_a_long_random_secret
# Telegram integration (optional)
TELEGRAM_BOT_TOKEN=replace_me_if_you_enable_telegram
